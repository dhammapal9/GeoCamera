<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:left="24dp" android:right="24dp" android:top="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_500" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
