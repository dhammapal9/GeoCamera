<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#5B2BC9"
                android:centerColor="#8B3BE2"
                android:endColor="#D96CE5"
                android:type="linear" />
            <corners android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="520"
                android:startColor="#44FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
        </shape>
    </item>
</layer-list>
