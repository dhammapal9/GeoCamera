<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_xs">
    <TextView
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/gallerySectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textStyle="bold"
        android:textAppearance="@style/TextAppearance.GeoStamp.Title"
        tools:text="Today" />
    <TextView
        android:id="@+id/gallerySectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.GeoStamp.Caption"
        android:text="0" />
</LinearLayout>
