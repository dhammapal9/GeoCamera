<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed gradient hero. Background drawable is swapped per page from code. -->
    <FrameLayout
        android:id="@+id/heroPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:background="@drawable/bg_onboarding_hero_1"
        android:elevation="6dp">

        <!-- Decorative floating circle for depth -->
        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-80dp"
            android:background="@drawable/bg_onboarding_dot_inactive"
            android:alpha="0.5" />

        <!-- Icon tile centred in the hero -->
        <FrameLayout
            android:id="@+id/heroIconHolder"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_onboarding_icon_tile">
            <ImageView
                android:id="@+id/pageIcon"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:tint="@color/white_pure"
                android:contentDescription="@null"
                android:src="@drawable/ic_location" />
        </FrameLayout>
    </FrameLayout>

    <!-- Text zone: step chip, title, body -->
    <LinearLayout
        android:id="@+id/textZone"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            android:id="@+id/stepChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_onboarding_step_chip"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:text="STEP 1 / 3" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.GeoStamp.Display"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.05"
            android:letterSpacing="-0.01"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/pageBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.GeoStamp.Body"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
