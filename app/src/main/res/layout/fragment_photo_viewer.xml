<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_photo_viewer">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/viewerToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_camera_top_scrim"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.GeoStamp.DarkPopup"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/photo_viewer"
        app:titleTextColor="@color/white_pure"
        app:navigationIconTint="@color/white_pure"
        app:subtitleTextColor="@color/white_pure"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/photoImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/cd_photo"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/viewerToolbar"
        app:layout_constraintBottom_toTopOf="@id/toggleBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintBottom_toTopOf="@id/infoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStamped"
            style="@style/Widget.GeoStamp.CameraChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/viewer_show_stamped"
            android:checked="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOriginal"
            style="@style/Widget.GeoStamp.CameraChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/viewer_show_original" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#E60A0E13"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="4dp"
        android:layout_margin="@dimen/spacing_md"
        app:layout_constraintBottom_toTopOf="@id/adContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_lg">
            <TextView
                android:id="@+id/infoAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white_pure"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/infoCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="#B3FFFFFF"
                android:textAppearance="@style/TextAppearance.GeoStamp.Body" />
            <TextView
                android:id="@+id/infoTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:textColor="#99FFFFFF"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
