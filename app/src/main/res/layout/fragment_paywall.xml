<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/paywallToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/paywall_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardBackgroundColor="@color/brand_primary">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paywall_title"
                        android:textColor="@color/white_pure"
                        android:textAppearance="@style/TextAppearance.GeoStamp.Display"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/paywall_subtitle"
                        android:textColor="#DDFFFFFF"
                        android:textAppearance="@style/TextAppearance.GeoStamp.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl">
                <include layout="@layout/view_paywall_bullet" android:id="@+id/bullet1" />
                <include layout="@layout/view_paywall_bullet" android:id="@+id/bullet2" />
                <include layout="@layout/view_paywall_bullet" android:id="@+id/bullet3" />
                <include layout="@layout/view_paywall_bullet" android:id="@+id/bullet4" />
                <include layout="@layout/view_paywall_bullet" android:id="@+id/bullet5" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonthly"
                style="@style/Widget.GeoStamp.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/paywall_cta_monthly"
                app:icon="@drawable/ic_check" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLifetime"
                style="@style/Widget.GeoStamp.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/paywall_cta_lifetime"
                app:icon="@drawable/ic_check" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/paywall_restore" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSimulatePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/paywall_demo_toggle" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_ad_container" />
</LinearLayout>
