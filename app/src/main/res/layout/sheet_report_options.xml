<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_lg">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOnSurfaceVariant"
        android:alpha="0.5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/report_sheet_title"
        android:textAppearance="@style/TextAppearance.GeoStamp.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:text="@string/report_sheet_body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.GeoStamp.Body" />

    <LinearLayout
        android:id="@+id/optionPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_report"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_pdf"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_pdf_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_share"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_email"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_email_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_share"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_share_photo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_share_photo_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_gallery"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_view"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_view_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_copy"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_copy"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_copy_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_check"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@null" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md">
            <TextView
                android:text="@string/report_action_rate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeoStamp.Title" />
            <TextView
                android:text="@string/report_action_rate_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.GeoStamp.Caption" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/report_action_dismiss" />
</LinearLayout>
