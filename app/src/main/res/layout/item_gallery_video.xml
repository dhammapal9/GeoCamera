<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/videoThumb"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="#1A000000"
            android:contentDescription="@null" />

        <!-- Bottom gradient so the duration label stays legible. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_camera_bottom_scrim" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_camera"
            android:tint="#CCFFFFFF"
            android:background="#55000000"
            android:padding="8dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/videoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:textColor="@color/white_pure"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/videoDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:textColor="#DDFFFFFF"
            android:textSize="10sp" />
        <View
            android:id="@+id/videoSelectionTint"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_item_selected"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/videoSelectCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_selection_check"
            android:padding="2dp"
            android:src="@drawable/ic_check"
            android:tint="@color/white_pure"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
